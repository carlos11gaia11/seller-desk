+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+
+import '../../common.dart';
+
+const _orange = Color(0xFFFF8A24);
+
+class SellerDeskHeader extends StatelessWidget {
+  const SellerDeskHeader({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    return const Padding(
+      padding: EdgeInsets.fromLTRB(24, 24, 24, 20),
+      child: Row(children: [
+        ColoredBox(
+          color: Color(0xFF0C0C0C),
+          child: Padding(
+            padding: EdgeInsets.symmetric(horizontal: 12, vertical: 2),
+            child: Text('S', style: TextStyle(fontSize: 34,
+              fontWeight: FontWeight.w900, color: _orange)),
+          ),
+        ),
+        SizedBox(width: 12),
+        Expanded(child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text('Seller Desk', style: TextStyle(
+              fontSize: 28, fontWeight: FontWeight.w800)),
+            Text('Suporte remoto, sem complicação.',
+              style: TextStyle(fontSize: 13)),
+          ],
+        )),
+      ]),
+    );
+  }
+}
+
+class SellerDeskCodeCard extends StatelessWidget {
+  const SellerDeskCodeCard({super.key,
+    required this.controller, required this.settings});
+
+  final TextEditingController controller;
+  final Widget settings;
+
+  @override
+  Widget build(BuildContext context) {
+    return Container(
+      margin: const EdgeInsets.symmetric(horizontal: 20),
+      padding: const EdgeInsets.all(20),
+      decoration: BoxDecoration(
+        color: const Color(0xFF141414),
+        borderRadius: BorderRadius.circular(20),
+        border: Border.all(color: _orange, width: 1.5),
+      ),
+      child: ValueListenableBuilder<TextEditingValue>(
+        valueListenable: controller,
+        builder: (context, value, child) {
+          final raw = value.text.trim();
+          final ready = RegExp(r'^\d[\d\s]*$').hasMatch(raw);
+          final digits = raw.replaceAll(RegExp(r'\s'), '');
+          final display = ready
+              ? digits.replaceAllMapped(RegExp(r'.{1,3}'), (m) => '${m[0]} ').trim()
+              : raw.isEmpty ? 'Aguardando código…' : raw;
+          return Column(
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              Row(children: [
+                const Expanded(child: Text('SEU CÓDIGO DE ACESSO',
+                  style: TextStyle(color: _orange, fontSize: 12,
+                    fontWeight: FontWeight.w700, letterSpacing: 1.2))),
+                settings,
+              ]),
+              const SizedBox(height: 14),
+              Semantics(
+                label: 'Seu código de acesso: $raw',
+                excludeSemantics: true,
+                child: FittedBox(
+                  fit: BoxFit.scaleDown,
+                  alignment: Alignment.centerLeft,
+                  child: Text(display, style: TextStyle(
+                    fontSize: ready ? 64 : 22,
+                    height: 1.15,
+                    fontWeight: FontWeight.w800,
+                    color: Colors.white,
+                  )),
+                ),
+              ),
+              const SizedBox(height: 12),
+              const Text('Passe este código para quem vai ajudar você.',
+                style: TextStyle(color: Colors.white70, fontSize: 14)),
+              const SizedBox(height: 18),
+              ElevatedButton.icon(
+                style: ElevatedButton.styleFrom(
+                  backgroundColor: _orange,
+                  foregroundColor: Colors.black,
+                  padding: const EdgeInsets.symmetric(vertical: 16),
+                ),
+                onPressed: ready ? () async {
+                  try {
+                    await Clipboard.setData(ClipboardData(text: digits));
+                    showToast('Código copiado');
+                  } catch (_) {
+                    showToast('Não foi possível copiar. Leia o código acima.');
+                  }
+                } : null,
+                icon: const Icon(Icons.copy_rounded, size: 18),
+                label: const Text('Copiar código'),
+              ),
+            ],
+          );
+        },
+      ),
+    );
+  }
+}
+
+class SellerDeskTutorial extends StatelessWidget {
+  const SellerDeskTutorial({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    return Container(
+      margin: const EdgeInsets.fromLTRB(20, 4, 20, 20),
+      padding: const EdgeInsets.all(18),
+      decoration: BoxDecoration(
+        border: Border.all(color: _orange.withOpacity(0.35)),
+        borderRadius: BorderRadius.circular(16),
+      ),
+      child: const Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text('Como receber ajuda', style: TextStyle(
+            fontSize: 17, fontWeight: FontWeight.w700)),
+          SizedBox(height: 12),
+          _Step('1', 'Deixe o Seller Desk aberto e conectado à internet.'),
+          _Step('2', 'Envie seu código para a pessoa de confiança que vai ajudar.'),
+          _Step('3', 'Aceite a solicitação de acesso ou informe a senha, se solicitada.'),
+          SizedBox(height: 8),
+          Text('Para ajudar alguém: abra “Acessar computador” e digite o código recebido. Em janelas maiores, use o painel ao lado.',
+            style: TextStyle(fontSize: 12, height: 1.4)),
+          SizedBox(height: 10),
+          Text('Você pode encerrar a sessão quando quiser.',
+            style: TextStyle(color: _orange, fontSize: 12)),
+        ],
+      ),
+    );
+  }
+}
+
+class _Step extends StatelessWidget {
+  const _Step(this.number, this.text);
+  final String number;
+  final String text;
+
+  @override
+  Widget build(BuildContext context) {
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 10),
+      child: Row(crossAxisAlignment: CrossAxisAlignment.start, children: [
+        Text(number, style: const TextStyle(
+          color: _orange, fontWeight: FontWeight.w800)),
+        const SizedBox(width: 12),
+        Expanded(child: Text(text,
+          style: const TextStyle(fontSize: 13, height: 1.4))),
+      ]),
+    );
+  }
+}
